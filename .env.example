# Lumina Voice Tutor — backend environment template
# Copy to `.env` at this path and fill in real values. Never commit `.env`.

# --- Runtime ---
HOST=0.0.0.0
PORT=8805
# development | production
ENVIRONMENT=development

# --- Security (required in production) ---
# Shared with tutor-frontend/.env.local — signs voice tickets, JWTs, tutor_context.
# Use a long random string. Server-only.
SESSION_SECRET=
# Optional dedicated JWT key. Falls back to SESSION_SECRET when unset.
AUTH_SECRET=
# Comma-separated browser origin(s) for the Next.js app, e.g. https://app.example.com
# Development: leave empty → CORS allows local Next.js on :3000.
# Production: required — wildcard CORS is blocked.
FRONTEND_ORIGIN=

# --- Auth storage / limits (optional locally) ---
# REDIS_URL=redis://127.0.0.1:6379
# AUTH_DB_PATH=server/data/auth.sqlite
# ALLOW_ANONYMOUS_WS=0

# --- Voice session limits ---
MAX_CONCURRENT_SESSIONS=20
MAX_CONNECTS_PER_IP_PER_MIN=8
TEXT_INPUT_MAX_CHARS=2000

# --- Provider API keys (server-only; never NEXT_PUBLIC_) ---
# Required for a live tutoring session:
SARVAM_API_KEY=
CEREBRAS_API_KEY=
CARTESIA_API_KEY=
# Recommended for LLM failover when Cerebras rate-limits:
GROQ_API_KEY=
# Optional second Cerebras key (separate rate-limit bucket):
CEREBRAS_API_KEY_2=

# --- Language tuning (optional) ---
DEFAULT_SESSION_LANGUAGE=en-IN
LANGUAGE_MIN_CHARS=8
LANGUAGE_MIN_CONFIDENCE=0.55
LANGUAGE_CONFIRMATIONS=1

# --- Optional audio preprocessing ---
# Server-side RNNoise denoising (after AudioGate, before Silero VAD).
# Requires pyrnnoise wheel (ships prebuilt librnnoise). Default off for A/B testing.
RNNOISE_ENABLED=false

# --- Debug (development only) ---
# DEBUG_TTS_INPUT=1

# --- Vercel frontend (set on Render after deploy) ---
# FRONTEND_ORIGIN=https://your-app.vercel.app
