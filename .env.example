# Lumina Voice Tutor — backend environment template
# Copy to `.env` at this path and fill in real values. Never commit `.env`.

# --- Runtime ---
HOST=0.0.0.0
PORT=8805
# development | production
ENVIRONMENT=development

# --- Security (required) ---
# Shared with tutor-frontend/.env.local — signs voice tickets, JWTs, tutor_context.
# Required at startup. There is no default. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Server-only. Never commit the value.
SESSION_SECRET=
# Optional dedicated JWT key. If unset, SESSION_SECRET is used.
AUTH_SECRET=
# Comma-separated browser origin(s) for the Next.js app, e.g. https://app.example.com
# Development: leave empty → CORS allows local Next.js on :3000.
# Production: required — wildcard CORS is blocked.
FRONTEND_ORIGIN=

# --- Auth storage / limits ---
# Production (Railway): REDIS_URL is required so rate limits / tickets can
# share across instances. Locally you may leave it unset (SQLite fallback).
# REDIS_URL=redis://127.0.0.1:6379
# AUTH_DB_PATH=server/data/auth.sqlite
# ALLOW_ANONYMOUS_WS=0
# Local demo login (never used in production). Sign-in still goes through
# FastAPI password verification — this only seeds a SQLite user.
# ENABLE_DEMO_LOGIN=true
# DEMO_LOGIN_EMAIL=dev@localhost
# DEMO_LOGIN_PASSWORD=

# --- Voice session limits ---
MAX_CONCURRENT_SESSIONS=20
MAX_CONNECTS_PER_IP_PER_MIN=8
TEXT_INPUT_MAX_CHARS=2000
# Seconds before CallMute auto-unmutes if the student never says "I'm back".
# CALL_MUTE_TIMEOUT_SECS=40
# Word-count floor for treating a muted utterance as lesson speech (unmutes).
# CALL_MUTE_RESUME_MIN_WORDS=6
# Tutor awaiting_* flags auto-clear after this many unresolved turns / seconds.
# AWAITING_MISS_RESUME_AFTER=3
# AWAITING_TIMEOUT_SECS=40

# --- Provider API keys (server-only; never NEXT_PUBLIC_) ---
# Required for a live tutoring session (LLM_PROVIDER=openai):
SARVAM_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=

# --- LLM ---
# openai | openrouter | gemini | groq  (production default: openai)
LLM_PROVIDER=openai
# Voice default: gpt-5.6-luna (fast). Avoid o-series reasoning models.
# LLM_MODEL=gpt-5.6-luna
# Manual provider switch only — not used when LLM_PROVIDER=openai:
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# --- Language tuning (optional) ---
DEFAULT_SESSION_LANGUAGE=en-IN
LANGUAGE_MIN_CHARS=8
LANGUAGE_MIN_CONFIDENCE=0.55
LANGUAGE_CONFIRMATIONS=1

# --- Optional audio preprocessing ---
# Server-side RNNoise denoising (after AudioGate, before Silero VAD).
# Requires pyrnnoise wheel (ships prebuilt librnnoise). Default off for A/B testing.
RNNOISE_ENABLED=false

# --- Pipeline timing / TTS model (optional; unset = current production defaults) ---
# Silero VAD. stop_secs must stay ≥ Sarvam negative_frames silence (~1.12s).
# VAD_START_SECS=0.2
# VAD_STOP_SECS=1.1
# STT_KEEPALIVE_TIMEOUT_SECS=15
# STT_KEEPALIVE_INTERVAL_SECS=5
# SARVAM_MIN_SPEECH_FRAMES=6
# SARVAM_NEGATIVE_FRAMES_COUNT=35
# SARVAM_NEGATIVE_FRAMES_WINDOW=48
# SARVAM_PRE_SPEECH_PAD_FRAMES=16
# AUDIO_GATE_DECAY_SECS=0.35
# SILENCE_THRESHOLD_SECS=15
# MEDIUM_SILENCE_THRESHOLD_SECS=120
# LONG_SILENCE_THRESHOLD_SECS=300
# USER_TURN_STOP_TIMEOUT_SECS=3
# LLM_EMPTY_GUARD_TIMEOUT_SECS=20
# CARTESIA_TTS_MODEL=sonic-3.5

# Optional TTS fallback when Cartesia returns billing/quota errors (HTTP 402).
# openai — uses OPENAI_API_KEY. Unset → tutor text still reaches the transcript (no silence).
# TTS_FALLBACK_PROVIDER=openai

# --- Debug (development only) ---
# DEBUG_TTS_INPUT=1

# --- Vercel frontend (set on Railway after deploy) ---
# FRONTEND_ORIGIN=https://your-app.vercel.app
