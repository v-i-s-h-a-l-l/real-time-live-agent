# Lumina Voice Tutor — environment template
# Copy to .env and fill in real values. Never commit the real .env.

HOST=0.0.0.0
PORT=8805

# development | production
# In production, DEBUG_TTS_INPUT is off unless you set it explicitly.
# Leave unset locally so TTS input can be traced in logs.
ENVIRONMENT=development

# Production: your Vercel URL (comma-separated for multiple).
# Empty allows all origins so local Next.js on :3000 can connect.
# FRONTEND_ORIGIN=https://your-app.vercel.app
FRONTEND_ORIGIN=

# Opt-in: log the text sent toward Cartesia (never audio or keys).
# DEBUG_TTS_INPUT=1

DEFAULT_SESSION_LANGUAGE=en-IN
LANGUAGE_MIN_CHARS=8
LANGUAGE_MIN_CONFIDENCE=0.55
LANGUAGE_CONFIRMATIONS=1

GROQ_API_KEY=
CEREBRAS_API_KEY=
# Optional. LLM failover order is Cerebras -> Cerebras 2 -> Groq. A second
# Cerebras key from a different account gets its own rate-limit bucket, so
# "queue_exceeded" bursts stay on the same provider and model.
CEREBRAS_API_KEY_2=
SARVAM_API_KEY=
CARTESIA_API_KEY=
