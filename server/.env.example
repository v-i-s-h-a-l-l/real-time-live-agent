# Backend environment template (Railway / local FastAPI)
# Canonical copy lives at repository root: ../.env.example
# Copy to ../.env for local dev or set variables in the Railway dashboard.

# See ../.env.example for the full variable list and production checklist.
# Quick reference:
#
#   ENVIRONMENT=production
#   SESSION_SECRET=   # required; python -c "import secrets; print(secrets.token_hex(32))"
#   FRONTEND_ORIGIN=https://your-app.vercel.app
#   SARVAM_API_KEY=...
#   OPENAI_API_KEY=...
#   LLM_PROVIDER=openai
#   CARTESIA_API_KEY=...
#   REDIS_URL=...   # required in production (Railway)
#   ALLOW_ANONYMOUS_WS=0
#
# Start command (Render):
#   uvicorn main:app --host 0.0.0.0 --port $PORT --app-dir server
#
# Deploy guide: ../docs/deployment.md
