# Lumina tutor frontend — copy to `.env.local` and adjust.
# Restart `next dev` / redeploy on Vercel after changing any value.

# --- Public (browser-safe) ---
# Voice WebSocket — browser connects DIRECTLY to Render (not through Vercel).
# Development:
NEXT_PUBLIC_VOICE_WS_URL=ws://127.0.0.1:8805/ws
# Production (Vercel):
# NEXT_PUBLIC_VOICE_WS_URL=wss://YOUR-SERVICE.onrender.com/ws

NEXT_PUBLIC_VOICE_LANG=auto

# --- Server-only (Next.js API routes; NEVER NEXT_PUBLIC_) ---
# Required at startup. There is no default. Must match the backend secret.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Render backend HTTPS origin (auth proxy, voice ticket minting).
# Development:
VOICE_API_URL=http://127.0.0.1:8805
# Production (Vercel):
# VOICE_API_URL=https://YOUR-SERVICE.onrender.com

# Optional dedicated JWT key. Defaults to SESSION_SECRET.
# AUTH_SECRET=

# NOTE: There is no NEXT_PUBLIC_API_URL — the browser uses same-origin /api/*
# routes; only the Next.js server calls VOICE_API_URL.
